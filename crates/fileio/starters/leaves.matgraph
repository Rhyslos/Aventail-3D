    "frames": [
      {
        "id": 7,
        "title": "1. Draw the leaves",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          710.0
        ],
        "note": "Double-click Shape to open its canvas. One leaf is drawn (outline, stem, veins as lines), grouped, with a serrated edge. The others are linked copies: change one and all change, but Vary copies gives each its own size, turn, colour and teeth. Layout: Leaf sheet lays them out apart."
      },
      {
        "id": 8,
        "title": "2. Colour",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          380.0,
          380.0
        ],
        "note": "The leaves' own colours, darker along the veins, with blotches from Clouds: a little darker and yellower here and there."
      },
      {
        "id": 9,
        "title": "3. Material",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          420.0,
          0.0
        ],
        "max": [
          600.0,
          330.0
        ],
        "note": "Material from height makes the bumps: rounded leaves with sunken veins."
      },
      {
        "id": 10,
        "title": "4. Cut out",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          640.0,
          0.0
        ],
        "max": [
          1040.0,
          360.0
        ],
        "note": "Opacity cuts the card out by the Mask: the game shows only the leaves. Translucency lets light through them from behind. Export textures… makes an alpha card for the engine chosen."
      }
    ]

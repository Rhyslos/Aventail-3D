    "frames": [
      {
        "id": 17,
        "title": "1. Lay the tiles",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          560.0
        ],
        "note": "Start here. Tiles lays a neat grid; Shift moves every other row along. Noise is the stone's rough surface."
      },
      {
        "id": 18,
        "title": "2. Cut the stones",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          1040.0,
          510.0
        ],
        "note": "Warp wobbles the straight edges so the stones look cut by hand. Bevel rounds them into height, Random lifts each stone a little, and the noise (made stronger by Levels) roughens them."
      },
      {
        "id": 19,
        "title": "4. Colour the stone",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          1300.0,
          0.0
        ],
        "max": [
          1480.0,
          340.0
        ],
        "note": "Gradient map colours by height: dark in the cracks, light on the tops. Try warmer or cooler greys."
      },
      {
        "id": 20,
        "title": "6. Finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1520.0,
          0.0
        ],
        "max": [
          2140.0,
          330.0
        ],
        "note": "Mix materials by height lays the moss where it stands higher than the stone: in the gaps. Rise moves the moss up or down. One repeat is 2 m across."
      },
      {
        "id": 21,
        "title": "3. Light edges",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          420.0,
          560.0
        ],
        "max": [
          1260.0,
          890.0
        ],
        "note": "Edge finder draws a line just inside each stone. Added to the height, it makes the edges come out lighter when coloured: the way stone is painted by hand."
      },
      {
        "id": 22,
        "title": "5. Moss",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          -20.0,
          940.0
        ],
        "max": [
          600.0,
          1250.0
        ],
        "note": "Billowy Clouds makes soft clumps; Gradient map colours them green. Material from height makes the moss a material of its own."
      }
    ]
  },

    "frames": [
      {
        "id": 16,
        "title": "1. Earth",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          600.0,
          310.0
        ],
        "note": "Start here. Noise with lots of Detail makes lumpy earth; Gradient map colours it, dark in the dips."
      },
      {
        "id": 17,
        "title": "4. Layer them",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          860.0,
          0.0
        ],
        "max": [
          1480.0,
          330.0
        ],
        "note": "Mix materials by height puts the pebbles on the earth where they stand higher. Then by shape, the grass patches go on top. One repeat is 2 m."
      },
      {
        "id": 18,
        "title": "2. Pebbles",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          -20.0,
          360.0
        ],
        "max": [
          820.0,
          850.0
        ],
        "note": "Cells makes a bump for every pebble. Levels keeps only the tallest bumps, so the pebbles are small and scattered (Darkest: fewer or more); Warp makes them less round."
      },
      {
        "id": 19,
        "title": "3. Grass",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          -20.0,
          900.0
        ],
        "max": [
          600.0,
          1390.0
        ],
        "note": "Billowy Clouds makes patches. Levels picks where the grass grows (Darkest: less or more grass)."
      }
    ]

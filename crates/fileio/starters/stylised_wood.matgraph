    "frames": [
      {
        "id": 14,
        "title": "1. Big shapes first",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          580.0
        ],
        "note": "Start here. Hand-painted textures start big and simple: a few wide boards (Planks), and stripes (Gradient) for the grain."
      },
      {
        "id": 15,
        "title": "2. Grain",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          600.0,
          310.0
        ],
        "note": "Warp bends the stripes into flowing grain; Levels makes the bands bolder, as a painter would simplify them."
      },
      {
        "id": 16,
        "title": "5. Colour and finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1300.0,
          0.0
        ],
        "max": [
          1920.0,
          310.0
        ],
        "note": "Gradient map picks warm, saturated browns (hand-painted wood is often more orange than real wood). Occlusion is low, as the shade is already painted."
      },
      {
        "id": 17,
        "title": "3. Chunky edges",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          360.0
        ],
        "max": [
          820.0,
          680.0
        ],
        "note": "A sharp Bevel gives each board a clear, chunky edge. The grain is added as a slight ridge."
      },
      {
        "id": 18,
        "title": "4. Paint in the light",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          200.0,
          730.0
        ],
        "max": [
          1260.0,
          1060.0
        ],
        "note": "In hand-painted art the light is in the colour: Edge finder paints bright board edges (Lighter keeps the lighter grey), Random gives each board its own shade, and the gaps go dark."
      }
    ]
  },

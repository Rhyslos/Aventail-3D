    "frames": [
      {
        "id": 15,
        "title": "1. Lay the bricks",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          380.0,
          540.0
        ],
        "note": "Start here. Bricks lays the pattern: white bricks, black mortar. Rows and Bricks per row set how many; Mortar sets the gaps. Noise, made stronger by Levels, is a fine grain used twice later: a rough surface and blotchy colour."
      },
      {
        "id": 16,
        "title": "2. Shape them",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          590.0
        ],
        "max": [
          1040.0,
          920.0
        ],
        "note": "Warp nudges the edges so the bricks look handmade. Bevel turns the flat pattern into height with rounded edges. Then each brick gets its own small lift (Random), and the grain roughens the surface."
      },
      {
        "id": 17,
        "title": "4. Colour",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          1080.0,
          0.0
        ],
        "max": [
          1260.0,
          360.0
        ],
        "note": "Gradient map turns those greys into colours: the left end is mortar, the rest brick reds. Click it and change the colours to make other bricks."
      },
      {
        "id": 18,
        "title": "5. Finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1300.0,
          0.0
        ],
        "max": [
          1700.0,
          330.0
        ],
        "note": "Material from height makes the bumps catch the light, and adds the colour. Material out says one repeat covers 90 cm, about four bricks across."
      },
      {
        "id": 19,
        "title": "3. A grey for each part",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          200.0,
          970.0
        ],
        "max": [
          820.0,
          1520.0
        ],
        "note": "Before colouring, this builds a grey that says what each spot is: black for mortar, a different grey for each brick, blotches from the grain, and lighter edges (Edge finder), as a painter would pick out edges."
      }
    ]
  },

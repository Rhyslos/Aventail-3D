      {
        "id": 10,
        "title": "1. Boards",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          400.0
        ],
        "note": "Start here. Planks lays the boards and gives three things: their shape, a grey for each board (Random) and the grain."
      },
      {
        "id": 11,
        "title": "2. Shape",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          820.0,
          330.0
        ],
        "note": "Bevel rounds each board's edges into height. The grain is added as tiny ridges, and Random lifts some boards a little, as real floors are uneven."
      },
      {
        "id": 12,
        "title": "4. Colour and finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          860.0,
          0.0
        ],
        "max": [
          1480.0,
          310.0
        ],
        "note": "Gradient map turns the greys into wood colours; Material from height adds the light. One repeat is 1.2 m across."
      },
      {
        "id": 13,
        "title": "3. A grey for the colour",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          200.0,
          380.0
        ],
        "max": [
          600.0,
          730.0
        ],
        "note": "Random and grain mixed give each board its own shade with streaks. Multiplying by the bevel makes the gaps and edges dark."
      }

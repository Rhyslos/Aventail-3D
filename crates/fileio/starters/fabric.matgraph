    "frames": [
      {
        "id": 17,
        "title": "1. Stripes",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          380.0,
          510.0
        ],
        "note": "Start here. Two Gradient boxes make stripes, one across and one down. Levels makes their soft ramps into hard black and white stripes."
      },
      {
        "id": 18,
        "title": "2. A chequer",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          420.0,
          0.0
        ],
        "max": [
          820.0,
          590.0
        ],
        "note": "Each stripe taken from the other, and the two added: white where only one set of stripes is white. That is a chequer, which says where each thread is on top."
      },
      {
        "id": 19,
        "title": "4. Fibres",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          860.0,
          0.0
        ],
        "max": [
          1480.0,
          320.0
        ],
        "note": "Very fine Noise makes the threads fuzzy; Blur softens it all a touch."
      },
      {
        "id": 20,
        "title": "5. Colour and finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1520.0,
          0.0
        ],
        "max": [
          2140.0,
          330.0
        ],
        "note": "Gradient map dyes the cloth. Real-world size is small: one repeat is only 6 cm, so the threads are a sensible size on a model."
      },
      {
        "id": 21,
        "title": "3. Weave the threads",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          640.0,
          640.0
        ],
        "max": [
          1040.0,
          1150.0
        ],
        "note": "Two more Gradients are the round threads, one each way. Blend shows the threads going down where the chequer is white: over, under, over, as cloth is woven."
      }
    ]

    "frames": [
      {
        "id": 19,
        "title": "1. Plates and dots",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          780.0
        ],
        "note": "Start here. Tiles makes the plates, with thin seams. Basic shape makes a grid of small circles: the rivets to be. Clouds will be smudges."
      },
      {
        "id": 20,
        "title": "2. Rivets near the edges",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          1040.0,
          690.0
        ],
        "note": "Bevel puffs the circles into domes and rounds the plates. Edge finder and Levels make a band along each plate's edge; multiplied, only the rivets in the band stay. Lighter puts them on the plates."
      },
      {
        "id": 21,
        "title": "4. Colour and finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1960.0,
          0.0
        ],
        "max": [
          2580.0,
          330.0
        ],
        "note": "Gradient map gives steel greys. Metal is set to 1 and Roughness low, so it shines in the realistic preview. One repeat is 1 m."
      },
      {
        "id": 22,
        "title": "3. Worn edges and scratches",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          420.0,
          740.0
        ],
        "max": [
          1920.0,
          1290.0
        ],
        "note": "Painted metal shows bright, worn edges. Tiles' Random gives each plate its own tone, Edge finder adds the bright edges, and the clouds take a little away as smudges, so it isn't too clean. Scratches scores fine lines every way into the height, and adds them, bright, to the colour."
      }

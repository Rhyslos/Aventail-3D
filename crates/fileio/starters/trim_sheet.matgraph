    "frames": [
      {
        "id": 17,
        "title": "1. Bolts",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          820.0,
          320.0
        ],
        "note": "Start here. One round dome, made steel. In the sheet it is shrunk to fit its strip, so it repeats as a row of bolts."
      },
      {
        "id": 18,
        "title": "5. The trim sheet",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          860.0,
          0.0
        ],
        "max": [
          1260.0,
          510.0
        ],
        "note": "Each Strip becomes a band of the texture, from the top. They lie on the project's trim rows (the UV Editor's Trim menu) or, with none, share the height by their Heights (1, 3, 2, 2 here). Gap and bevelled edges make each read as a separate piece. On a model, put strips on the rows with Put on trim row."
      },
      {
        "id": 19,
        "title": "2. Painted panel",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          -20.0,
          370.0
        ],
        "max": [
          820.0,
          700.0
        ],
        "note": "Tall panels with thin seams, painted green. The sheet cuts a band from them at their own size, so they match the strips around them."
      },
      {
        "id": 20,
        "title": "3. Planks",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          -20.0,
          750.0
        ],
        "max": [
          820.0,
          1070.0
        ],
        "note": "Four rows of boards: a strip a quarter of the sheet tall holds exactly one row."
      },
      {
        "id": 21,
        "title": "4. Pipe",
        "colour": [
          160,
          80,
          95
        ],
        "min": [
          -20.0,
          1120.0
        ],
        "max": [
          820.0,
          1450.0
        ],
        "note": "Gradient running down, light in the middle, is a pipe's round shape; copper metal. Shrunk to fit, the whole shape fills its strip."
      }

    "frames": [
      {
        "id": 16,
        "title": "1. Plates",
        "colour": [
          86,
          110,
          140
        ],
        "min": [
          -20.0,
          0.0
        ],
        "max": [
          160.0,
          580.0
        ],
        "note": "Start here. Bark is made from Planks: boards with wide gaps become the plates of bark. Ridged Clouds will make cracks."
      },
      {
        "id": 17,
        "title": "2. Stand them up",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          200.0,
          0.0
        ],
        "max": [
          600.0,
          570.0
        ],
        "note": "Transform turns the boards and their grain a quarter, so they run up the trunk. Warp makes the plates irregular."
      },
      {
        "id": 18,
        "title": "3. Deep furrows",
        "colour": [
          150,
          115,
          60
        ],
        "min": [
          640.0,
          0.0
        ],
        "max": [
          1260.0,
          330.0
        ],
        "note": "A wide, round Bevel makes deep furrows between the plates. The ridged clouds multiply cracks into them, and the grain adds streaks."
      },
      {
        "id": 19,
        "title": "5. Colour and finish",
        "colour": [
          90,
          130,
          70
        ],
        "min": [
          1300.0,
          0.0
        ],
        "max": [
          2140.0,
          320.0
        ],
        "note": "Dark in the furrows, lighter on the plates. Mix materials by shape lays the lichen where Levels is white. One repeat is 60 cm."
      },
      {
        "id": 20,
        "title": "4. Lichen",
        "colour": [
          120,
          95,
          150
        ],
        "min": [
          860.0,
          380.0
        ],
        "max": [
          1260.0,
          890.0
        ],
        "note": "Billowy Clouds makes patches; Levels picks only the biggest (Darkest sets how much lichen)."
      }
    ]
